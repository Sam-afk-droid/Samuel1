def github_push_tree_task(task_id: str, files: list[AtlasFile], repo: str, token: str, project_id: str):
db_lock_project(project_id)
def update_status(status, msg):
write_task_state(task_id, status, msg, project_id)
update_status("running", "Initializing...")
headers = {"Authorization": f"token {token}", "Accept": "application/vnd.github+json"}
branch = "src"
try:
for attempt in range(3): # FIXED: retry logic
try:
ref_url = f"https://api.github.com/repos/{repo}/git/refs/heads/{branch}"
r_ref = requests.get(ref_url, headers=headers, timeout=REQUEST_TIMEOUT)
if r_ref.status_code == 404:
default_branch = requests.get(f"https://api.github.com/repos/{repo}", headers=headers, timeout=REQUEST_TIMEOUT).json()["default_branch"]
base_sha = requests.get(f"https://api.github.com/repos/{repo}/git/refs/heads/{default_branch}", headers=headers, timeout=REQUEST_TIMEOUT).json()["object"]["sha"]
requests.post(f"https://api.github.com/repos/{repo}/git/refs", headers=headers, json={"ref": f"refs/heads/{branch}", "sha": base_sha}, timeout=REQUEST_TIMEOUT)
parent_sha = base_sha
else:
parent_sha = r_ref.json()["object"]["sha"]
commit_obj = requests.get(f"https://api.github.com/repos/{repo}/git/commits/{parent_sha}", headers=headers, timeout=REQUEST_TIMEOUT).json()
base_tree_sha = commit_obj["tree"]["sha"]
tree_items = []
skipped = []
critical_files = {"main.py", "buildozer.spec", "atlas_contract.md"}
for f in files:
safe_path = sanitize_path(f.path) # FIXED: sanitize
if not safe_path:
skipped.append(f"{f.path} - illegal path")
if f.path in critical_files: raise Exception(f"Critical file {f.path} has illegal path. Aborting.")
continue
if len(f.content.encode()) > MAX_FILE_SIZE_B:
skipped.append(f"{safe_path} - exceeds 8MB limit")
if f.path in critical_files: raise Exception(f"Critical file {f.path} too large. Aborting.")
continue
tree_items.append({"path": safe_path, "mode": "100644", "type": "blob", "content": f.content})
if not tree_items: raise Exception(f"No valid files. Skipped: {skipped}")
update_status("running", "Creating Git tree...")
tree_res = requests.post(f"https://api.github.com/repos/{repo}/git/trees", headers=headers, json={"base_tree": base_tree_sha, "tree": tree_items}, timeout=REQUEST_TIMEOUT)
tree_res.raise_for_status()
new_tree_sha = tree_res.json()["sha"]
update_status("running", "Creating commit...")
commit_res = requests.post(f"https://api.github.com/repos/{repo}/git/commits", headers=headers, json={"message": f"Atlas: {len(tree_items)} files", "tree": new_tree_sha, "parents": [parent_sha]}, timeout=REQUEST_TIMEOUT)
commit_res.raise_for_status()
new_commit_sha = commit_res.json()["sha"]
update_status("running", "Updating branch ref...")
current_ref = requests.get(ref_url, headers=headers, timeout=REQUEST_TIMEOUT).json()
if current_ref["object"]["sha"]!= parent_sha: raise Exception("409 Conflict")
update_res = requests.patch(ref_url, headers=headers, json={"sha": new_commit_sha}, timeout=REQUEST_TIMEOUT)
update_res.raise_for_status()
verify = requests.get(f"https://api.github.com/repos/{repo}/git/trees/{new_tree_sha}", headers=headers, timeout=REQUEST_TIMEOUT)
if verify.json()["sha"]!= new_tree_sha: raise Exception("Tree SHA mismatch after push. Rollback.")
update_status("running", "Triggering workflow...")
wf_url = f"https://api.github.com/repos/{repo}/actions/workflows/build.yml/dispatches"
wf_res = requests.post(wf_url, headers=headers, json={"ref": branch}, timeout=REQUEST_TIMEOUT)
if wf_res.status_code == 403: raise Exception("Workflow dispatch 403: Token lacks 'workflow' scope")
wf_res.raise_for_status()
msg = f"https://github.com/{repo}/actions"
if skipped: msg += f"\nWarning: Skipped files: {'; '.join(skipped)}"
update_status("done", msg)
break # Success
except Exception as e:
if "409 Conflict" in str(e) and attempt < 2:
time.sleep(0.5 * (2 ** attempt)) # Exponential backoff
continue
else:
raise
except Exception as e:
update_status("error", str(e))
finally:
db_unlock_project(project_id)

