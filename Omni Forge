def generate_project(history: list) -> AtlasOutput | None:
res = model.generate_content(history)
return repair_and_validate_json(res.text, model)

def compress_history(history: list) -> list:
if len(history) <= 2: return history
compressed = []
for i, msg in enumerate(history):
if i >= len(history) - 2:
compressed.append(msg)
else:
compressed.append({"role": msg["role"], "parts": [msg["content"][:200]]})
return compressed

