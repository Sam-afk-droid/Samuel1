def db_connect():
conn = sqlite3.connect(TASK_DB, timeout=30, check_same_thread=False)
conn.execute(f"PRAGMA busy_timeout={DB_BUSY_TIMEOUT_MS}")
return conn

def init_db():
conn = db_connect()
conn.execute("PRAGMA journal_mode=WAL")
conn.execute("CREATE TABLE IF NOT EXISTS tasks (id TEXT PRIMARY KEY, status TEXT, msg TEXT, ts REAL, project_id TEXT)")
conn.execute("CREATE TABLE IF NOT EXISTS locks (project_id TEXT PRIMARY KEY, ts REAL)")
conn.execute("CREATE TABLE IF NOT EXISTS audit (id INTEGER PRIMARY KEY, ts REAL, ip TEXT, key_hash TEXT, endpoint TEXT, status INTEGER)")
conn.commit()
conn.close()

def db_lock_project(project_id: str):
conn = db_connect()
with conn: conn.execute("REPLACE INTO locks VALUES (?,?)", (project_id, time.time()))
conn.close()

def db_unlock_project(project_id: str):
conn = db_connect()
with conn: conn.execute("DELETE FROM locks WHERE project_id=?", (project_id,))
conn.close()

def is_project_locked(project_id: str) -> bool:
conn = db_connect()
cur = conn.execute("SELECT 1 FROM locks WHERE project_id=?", (project_id,))
locked = cur.fetchone() is not None
conn.close()
return locked

def write_task_state(task_id: str, status: str, msg: str, project_id: str = None):
init_db()
for attempt in range(3):
try:
conn = db_connect()
with conn: conn.execute("REPLACE INTO tasks VALUES (?,?,?,?,?)", (task_id, status, msg, time.time(), project_id))
conn.close()
return
except sqlite3.OperationalError as e:
if "locked" in str(e) and attempt < 2: time.sleep(0.1 * (2 ** attempt))
else: raise

def read_task_state(task_id: str) -> dict:
init_db()
conn = db_connect()
cur = conn.execute("SELECT status, msg, ts, project_id FROM tasks WHERE id=?", (task_id,))
row = cur.fetchone()
conn.close()
return {"status": row[0], "msg": row[1], "ts": row[2], "project_id": row[3]} if row else {"status": "idle", "msg": "", "ts": 0}

def audit_log(ip: str, key_hash: str, endpoint: str, status: int):
init_db()
conn = db_connect()
with conn: conn.execute("INSERT INTO audit (ts, ip, key_hash, endpoint, status) VALUES (?,?,?,?,?)", (time.time(), ip, key_hash, endpoint, status))
conn.close()

def check_api_quota(key_hash: str) -> bool:
conn = db_connect()
day_ago = time.time() - 86400
cur = conn.execute("SELECT COUNT(*) FROM audit WHERE key_hash=? AND endpoint='/generate' AND ts>?", (key_hash, day_ago))
count = cur.fetchone()[0]
conn.close()
return count < API_DAILY_QUOTA

def cleanup_old_projects():
init_db()
try:
total_size = sum(f.stat().st_size for f in PROJECTS_DIR.rglob('') if f.is_file())
if total_size > MAX_DISK_USAGE_MB * 1024 * 1024:
projects = sorted([p for p in PROJECTS_DIR.iterdir() if p.is_dir()], key=lambda p: p.stat().st_mtime)
while total_size > MAX_DISK_USAGE_MB * 1024 * 0.8 and len(projects) > 5:
old = projects.pop(0)
if is_project_locked(old.name): continue
total_size -= sum(f.stat().st_size for f in old.rglob('') if f.is_file())
shutil.rmtree(old)
now = time.time()
for p in PROJECTS_DIR.iterdir():
if p.is_dir() and not is_project_locked(p.name):
if (now - p.stat().st_mtime) < 300: continue
if (now - p.stat().st_mtime) > MAX_PROJECT_AGE_DAYS * 86400: shutil.rmtree(p)
except Exception as e: print(f"Cleanup error: {e}")

def save_project_files(project_id: str, files: list[AtlasFile]):
cleanup_old_projects()
proj_dir = PROJECTS_DIR / project_id
if proj_dir.exists(): shutil.rmtree(proj_dir)
proj_dir.mkdir()
for f in files:
(proj_dir / f.path).parent.mkdir(parents=True, exist_ok=True)
(proj_dir / f.path).write_text(f.content, encoding='utf-8')

def load_project_files(project_id: str) -> list[AtlasFile]:
proj_dir = PROJECTS_DIR / project_id
if not proj_dir.exists(): return []
files = []
for p in proj_dir.rglob("*"):
if p.is_file():
rel_path = p.relative_to(proj_dir).as_posix()
files.append(AtlasFile(path=rel_path, content=p.read_text(encoding='utf-8')))
return files

