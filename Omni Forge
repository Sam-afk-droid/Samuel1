def check_rate_limit(ip: str, limit: int) -> bool:
with RATE_LOCK:
now = time.time()
timestamps = RATE_LIMITER[ip]
timestamps = [t for t in timestamps if now - t < 60]
RATE_LIMITER[ip] = timestamps
if len(timestamps) >= limit: return False
timestamps.append(now)
return True

==================== VALIDATORS ====================

def is_jailbreak(text: str) -> bool:
return any(re.search(p, text, re.I) for p in JAILBREAK_PATTERNS)

def sanitize_path(path: str) -> str | None:
p = Path(path.strip().lstrip("/\"))
if ".." in p.parts or p.is_absolute(): return None
if re.search(ILLEGAL_CHARS, str(p)): return None
if p.stem.upper() in RESERVED_NAMES: return None
return str(p.as_posix())

def repair_and_validate_json(raw: str, model_obj, attempt: int = 0) -> AtlasOutput | None:
if attempt > 1: return None
try:
data = json.loads(raw)
return AtlasOutput(**data)
except (json.JSONDecodeError, ValidationError) as e:
if attempt == 0:
fix_prompt = f"Your last output was invalid JSON. Pydantic error: {e}. Return ONLY the corrected JSON object. Original:\n{raw[:4000]}"
try:
res = model_obj.generate_content(fix_prompt)
return repair_and_validate_json(res.text, model_obj, attempt + 1)
except: pass
return None

def ast_security_scan(code: str) -> tuple[bool, str]:
try:
tree = ast.parse(code)
for node in ast.walk(tree):
if isinstance(node, ast.Call):
if isinstance(node.func, ast.Name) and node.func.id in AST_BANNED_CALLS:
return False, f"Banned call: {node.func.id}()"
if isinstance(node.func, ast.Attribute) and isinstance(node.func.value, ast.Name):
if (node.func.value.id, node.func.attr) in AST_BANNED_ATTRS:
return False, f"Banned call: {node.func.value.id}.{node.func.attr}()"
except SyntaxError as e:
return False, f"Syntax error: {e}"
return True, "OK"

def validate_imports(files: list[AtlasFile]) -> tuple[bool, str]:
local_modules = {Path(f.path).stem for f in files if f.path.endswith(".py")}
for f in files:
if f.path.endswith(".py"):
try:
tree = ast.parse(f.content)
for node in ast.walk(tree):
mod = None
if isinstance(node, ast.Import):
for alias in node.names: mod = alias.name.split('.')[0]
elif isinstance(node, ast.ImportFrom) and node.module:
mod = node.module.split('.')[0]
if mod and mod not in RECIPE_WHITELIST and mod not in local_modules and mod not in MOBILE_STDLIB:
if importlib.util.find_spec(mod) is None:
return False, f"{f.path}: unknown import '{mod}'"
except SyntaxError: pass
return True, "OK"

def validate_python_files(files: list[AtlasFile]) -> tuple[bool, str]:
for f in files:
if f.path.endswith(".py"):
if len(f.content.splitlines()) > 150:
return False, f"File {f.path} exceeds 150 line limit."
ok, msg = ast_security_scan(f.content)
if not ok: return False, f"Security fail in {f.path}: {msg}"
return validate_imports(files)

def validate_contract(files: list[AtlasFile]) -> tuple[bool, str]:
if len(files) < 2: return True, "OK"
contract = next((f for f in files if f.path == "atlas_contract.md"), None)
if not contract: return False, "Multi-file project missing atlas_contract.md."
py_files = [f for f in files if f.path.endswith(".py") and f.path!= "main.py"]
missing = [f.path for f in py_files if "# CONTRACT:" not in f.content[:200]]
if missing: return False, f"Files missing contract header: {missing}."
return True, "OK"

def validate_android_rules(files: list[AtlasFile]) -> tuple[bool, str]:
for f in files:
if f.path.endswith(".py"):
for pattern in ANDROID_BANNED_PATTERNS:
if re.search(pattern, f.content):
return False, f"Android ban: Found '{pattern}' in {f.path}."
return True, "OK"

def validate_assets(files: list[AtlasFile]) -> list[AtlasFile]:
placeholders = [f for f in files if f.path.endswith("placeholder.txt")]
if not placeholders: return files
has_downloader = any(f.path == "utils/downloader.py" for f in files)
if not has_downloader:
asset_map = {}
for p in placeholders:
url_match = re.search(r'https?://\S+', p.content)
if url_match:
local_name = p.path.replace("placeholder.txt", "asset.bin")
asset_map[local_name] = url_match.group(0)
downloader_content = DOWNLOADER_PY + f"\nASSET_MAP = {json.dumps(asset_map, indent=4)}\n\nif name!= 'main':\n ensure_assets(ASSET_MAP)\n"
files.append(AtlasFile(path="utils/downloader.py", content=downloader_content))
main_file = next((f for f in files if f.path == "main.py"), None)
if main_file and "ensure_assets(ASSET_MAP)" not in main_file.content: # FIXED: idempotent
main_file.content = "from utils.downloader import ensure_assets, ASSET_MAP\nensure_assets(ASSET_MAP)\n" + main_file.content
return files

def run_all_validators(files: list[AtlasFile]) -> tuple[bool, str]:
for validator in [validate_python_files, validate_contract, validate_android_rules]:
ok, msg = validator(files)
if not ok: return False, msg
return True, "OK"

